extends ../layouts/page.pug

block content

  .actions
    a.btn-create(href=reverse('newUser')) Crear Nuevo Usuario

  h1 Usuarios Registrados
  
  if users.length === 0
    p No hay usuarios registrados
  else
    .users-list
      each user in users
        .user-card
          h2
            a(href=reverse('user', { id: user.id }))= user.name
          p ID: #{user.id}
          p Correo: #{user.email || 'No disponible'}
  .actions
    a.back-link(href=reverse('root')) ← Volver al inicio
