html(lang='es')
    head
        meta(CHARSET='UTF-8')
        meta(name='viewport', content='width=device-width, initial-scale=1.0')
        title codica-fastify 
        style 
            include ../styles/style.css
        body    
            header 
                nav 
                    a(href=reverse('root')) Inicio
                    a(href=reverse('users')) Usuarios 
                    a(href=reverse('courses')) Cursos                    
                    a(href=reverse('about')) Quiénes somos

                    if userId 
                        .user-section
                            span #{userName}
                            form(action=reverse('logout') method='post')
                                input(type='hidden' name='_method' value='delete')
                                button(type='submit') Cerrar Sesión 
                    else
                        .user-section
                            a.btn-login-nav(href=reverse('login')) Iniciar Sesión
                    
            main                
                if flash  
                    each messages, type in flash    
                        each message in messages 
                            .alert(class=`alert-${type}`)= message

                block content 

            footer 
                p Desarrollado por 
                    a(href='https://github.com/luisfelipemontoya') Luis Felipe Montoya Munera