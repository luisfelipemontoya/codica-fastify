extends ../layouts/page.pug

block content

    .actions
        a.btn-create(href=reverse('newCourse')) Crear Nuevo Curso

    h1= header 

    //- Formulario de búsqueda
    .search-form.form-container    
        form(action=reverse('courses') method='GET')
            input(
                type='search'
                name='term'
                placeholder='Buscar cursos...'
                value=term
            )
            input(type='submit' value='Buscar')

    //- Resultados de búsqueda
    if term
        p Resultados para: #{term}


    if courses.lenght === 0
        p No hay cursos disponibles 
    else    
        each course in courses 
            .course-card    
                h2  
                    a(href=reverse('course', { id: course.id }))= course.title 
                p= course.description 
                if course.duration
                    p Duración: #{course.duration} horas
                if course.tags
                    p Tags: #{course.tags.join(', ')}
                .user-actions
                    a.btn-edit(href=reverse('editCourse', { id: course.id })) ✏️ Editar
                    form(action=reverse('updateCourse', { id: course.id }) method='post')
                        input(type='hidden' name='_method' value='delete')
                        button.btn-delete(type='submit' onclick='return confirm("¿Eliminar curso?")') 🗑️ Eliminar
    .actions
        a.back-link(href=reverse('root')) ← Volver al inicio