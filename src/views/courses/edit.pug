extends ../layouts/page.pug

block content
  h1 Editar Curso

  if error
    .alert.alert-danger
      p= error.message
      if error.errors
        ul
          each err in error.errors
            li= err

  .create-form.form-container
    form(action=reverse('updateCourse', { id: course.id }) method='post')
      input(type='hidden' name='_method' value='patch')
      
      .form-group
        label(for='title') Título:
        input(
          type='text'
          name='title'
          id='title'
          value=course.title || ''
          required
        )
      
      .form-group
        label(for='description') Descripción:
        textarea(
          name='description'
          id='description'
          rows='4'
          required
        )= course.description || ''
      
      .form-group
        label(for='duration') Duración (horas):
        input(
          type='number'
          name='duration'
          id='duration'
          value=course.duration || ''
          min='1'
          required
        )
      
      .form-actions
        button(type='submit') Actualizar Curso
        a(href=reverse('courses')) Cancelar

  .actions
    a.back-link(href=reverse('courses')) ← Volver a cursos
    a.back-link(href=reverse('root')) ← Volver al inicio